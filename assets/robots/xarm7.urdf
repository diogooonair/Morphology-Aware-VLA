      <mass value="0.5"/>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
    </inertial>
  </link>

  <!-- Attach Gripper Base to the tool flange link_ee -->
  <joint name="gripper_base_joint" type="fixed">
    <parent link="link_ee"/>
    <child link="gripper_base_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.04"/> <!-- Offsets 4cm out along the tool Z axis -->
  </joint>

  <!-- 2. Left Finger (Active Prismatic Joint) -->
  <!-- 2. Left Finger (Active Prismatic Joint) -->
  <link name="left_finger_link">
    <visual><geometry><box size="0.02 0.01 0.06"/></geometry><material name="white"/></visual>
    <collision><geometry><box size="0.02 0.01 0.06"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
  </link>

  <joint name="gripper_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <!-- Start the left finger fully extended outward at -42.5mm -->
    <origin rpy="0 0 0" xyz="0.0 -0.0425 0.05"/>
    <axis xyz="0 1 0"/> <!-- Moves along +Y toward the right finger -->
    <!-- Max upper limit is 85mm (0.085m). At max, its Y position will be +0.0425 -->
    <limit effort="100.0" lower="0.0" upper="0.085" velocity="0.5"/>
  </joint>

  <!-- 3. Right Finger (Fixed to the far right edge) -->
  <link name="right_finger_link">
    <visual><geometry><box size="0.02 0.01 0.06"/></geometry><material name="white"/></visual>
    <collision><geometry><box size="0.02 0.01 0.06"/></geometry></collision>
