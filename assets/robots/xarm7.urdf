  <!-- ================= Custom xArm Gripper Integration ================= -->
  <!-- 1. The gripper base link -->
  <link name="gripper_base_link">
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.04"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
