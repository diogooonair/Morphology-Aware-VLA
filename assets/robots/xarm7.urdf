  </link>

  <joint name="right_finger_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <!-- Permanently fixed at +42.5mm. The left finger will meet it perfectly at max upper limit -->
    <origin rpy="0 0 0" xyz="0.0 0.0425 0.05"/>
  </joint>
